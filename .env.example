# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy anon key
# SERVER ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx                         # or the legacy service_role key

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: if set, /setup (first-time shop setup) asks for this code.
# Recommended for a public deployment so nobody else can claim the shop first.
SETUP_TOKEN=

# ---- Worker / notifications ----
CRON_SECRET=change-me-long-random-string
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Pet Shop <no-reply@example.com>"
