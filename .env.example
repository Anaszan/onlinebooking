# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy anon key
# SERVER ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx                         # or the legacy service_role key

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# shops get <slug>.ROOT_DOMAIN ; use sysrent.shop in production
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# extra hostnames that serve the platform itself (comma separated), e.g. Vercel preview URLs
ALLOWED_APP_HOSTS=

# ---- Worker / notifications ----
CRON_SECRET=change-me-long-random-string
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="SYSRENT Booking <no-reply@sysrent.shop>"
